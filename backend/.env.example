# Copy to .env for local development. In production these are set as environment variables on the host.

# One Postgres URL is enough — postgres://…, postgresql://… and postgresql+asyncpg://… are all accepted.
# Hosted databases that require TLS can append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_automation

# JWT signing secrets — generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-value

# Reserved for encrypting WhatsApp/Meta credentials at rest (later phase).
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# "development" (SQL echo on, lax cookies) or "production" (secure cross-site cookies, quiet logs)
ENVIRONMENT=development

# Frontend origins allowed to call this API (comma-separated). Include your production frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: also allow dynamic origins such as Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
