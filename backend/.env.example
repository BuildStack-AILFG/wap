# Copy to .env for local development. In production these are set as environment variables on the host.

# One Postgres URL is enough — postgres://…, postgresql://… and postgresql+asyncpg://… are all accepted.
# Hosted databases that require TLS can append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_automation

# JWT signing secrets — generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-value

# Encrypts WhatsApp access tokens, AI keys and integration secrets at rest. Any long random string works
# (python -c "import secrets; print(secrets.token_urlsafe(48))"). Changing it later makes stored credentials unreadable.
ENCRYPTION_KEY=change-me-to-a-long-random-value

# "development" (SQL echo on, lax cookies) or "production" (secure cross-site cookies, quiet logs)
ENVIRONMENT=development

# Frontend origins allowed to call this API (comma-separated). Include your production frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: also allow dynamic origins such as Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ---- Public URLs ----------------------------------------------------------------------------------------------------------
# This API's public https URL — shown as the WhatsApp webhook callback URL. Optional: derived from the request when unset.
# PUBLIC_BASE_URL=https://your-api.up.railway.app
# The web app's URL, used in invite / password-reset emails. Optional: defaults to the first non-localhost CORS origin.
# FRONTEND_URL=https://app.example.com

# ---- WhatsApp / Meta (all optional — workspaces can connect manually with their own credentials) ----------------------------
# Needed only for "Continue with Facebook" (Embedded Signup) and a shared platform webhook.
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# GRAPH_API_VERSION=v21.0

# ---- AI agent (optional) --------------------------------------------------------------------------------------------------------
# Platform key used when a workspace hasn't added its own; metered against the plan's included AI replies.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5

# ---- Email (optional) -------------------------------------------------------------------------------------------------------------
# Without it, invite / reset links are shown in the UI instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=LeadForGrow <no-reply@yourdomain.com>

# ---- Background jobs -------------------------------------------------------------------------------------------------------------
# Scheduled broadcasts, flow delays and delayed replies run in-process (single leader via a Postgres advisory lock).
# SCHEDULER_ENABLED=true

# ---- Platform admin console --------------------------------------------------------------------------------------------------
# Comma-separated emails allowed to open /admin (every workspace, plan, payment and user). Everyone else gets a 404.
# PLATFORM_ADMIN_EMAILS=you@company.com
