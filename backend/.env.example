# Copy to .env and fill in real values for your machine.

# Postgres connection (Phase 0: plain single instance, no pooling/replicas yet — see lib/PHASES.md)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_automation

# Used by Alembic (sync driver) — same DB, different driver
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/whatsapp_automation

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-value

# Secret used to encrypt WhatsApp/Meta credentials at rest later (Phase 1+) — not used yet.
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

ENVIRONMENT=development
