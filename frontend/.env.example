# Base URL of the backend API, including the /api prefix.
# Local development: put this in frontend/.env.local
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (Vercel): set this in Project Settings -> Environment Variables
#   NEXT_PUBLIC_API_URL=https://<your-backend-domain>/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# "Continue with Google" on login/signup. Same OAuth Web client id as GOOGLE_CLIENT_ID in the backend; the button is hidden when empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Homepage chat widget script (Dashboard -> Widget -> embed code). Must be reachable from visitors, so use the
# production backend URL on Vercel; localhost only works on your own machine.
NEXT_PUBLIC_HOME_WIDGET_SRC=
